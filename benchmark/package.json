{
  "type": "module",
  "scripts": {
    "toml": "hyperfine --warmup 5 --runs 10 'node toml.min.mjs' 'node toml.mjs'",
    "toml-eslint-parser": "hyperfine --warmup 5 --runs 10 'node toml.min.mjs' 'node toml-eslint-parser.mjs'",
    "smol-toml": "hyperfine --warmup 5 --runs 10 'node toml.min.mjs' 'node smol-toml.mjs'",
    "toml-patch": "hyperfine --warmup 5 --runs 10 'node toml.min.mjs' 'node toml-patch.mjs'",
