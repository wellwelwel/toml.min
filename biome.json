{
  "$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
  "files": {
    "include": ["**/**"],
    "ignore": [
      "node_modules",
      "lib",
      "browser",
      "benchmark",
      "coverage-reports",
      ".lagune"
    ]
  },
  "linter": {
    "enabled": true,
    "rules": {
      "all": true,
      "complexity": {
        "all": true,
        "noExcessiveCognitiveComplexity": "off"
      },
      "a11y": {
        "all": true
      },
      "correctness": {
        "all": true,
        "noNodejsModules": "off",
        "useImportExtensions": "error"
      },
      "nursery": {
        "all": true,
        "useImportRestrictions": "off",
        "noSecrets": "off",
        "useExplicitType": "off",
        "noNestedTernary": "off",
        "useAtIndex": "off",
        "noCommonJs": "off"
      },
      "performance": {
        "all": true,
        "noAccumulatingSpread": "error",
        "noBarrelFile": "error",
        "noDelete": "error",
        "noReExportAll": "error"
      },
      "security": {
        "all": true
      },
      "suspicious": {
        "all": true,
        "noConsoleLog": "off",
        "noEmptyBlockStatements": "off",
        "noConsole": "off"
      },
      "style": {
        "all": true,
        "useNamingConvention": "off",
        "noNamespaceImport": "off",
        "noDefaultExport": "error",
        "useBlockStatements": "off",
        "noNonNullAssertion": "off",
        "noRestrictedGlobals": {
          "level": "error",
          "options": { "deniedGlobals": ["Function"] }
        }
      }
    }
  },
  "overrides": [
    {
      "include": ["test", "tools"],
      "linter": {
        "rules": {
          "correctness": {
            "noNodejsModules": "off"
          },
          "performance": {
            "useTopLevelRegex": "off"
          },
          "suspicious": {
            "noApproximativeNumericConstant": "off"
          }
        }
      }
    },
    {
      "include": ["mcr.config.ts"],
      "linter": {
        "rules": {
          "style": {
            "noDefaultExport": "off"
          }
        }
      }
    }
  ]
}
