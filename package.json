{
  "name": "toml.min",
  "version": "1.0.0",
  "description": "🔧 Faster and lightweight TOML v1.1.0 parser for JavaScript and TypeScript.",
  "main": "./lib/index.js",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wellwelwel/toml.min.git"
  },
  "bugs": {
    "url": "https://github.com/wellwelwel/toml.min/issues"
  },
  "author": "https://github.com/wellwelwel",
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/wellwelwel"
  },
  "files": [
    "lib"
  ],
  "engines": {
    "node": ">=18.x.x"
  },
  "scripts": {
    "build": "tsc",
    "test": "poku -r=compact",
    "test:bun": "bun --bun poku -r=compact",
    "test:deno": "deno run -A npm:poku -r=compact",
    "test:coverage": "npm run test -- --coverage",
    "lint": "biome lint && prettier --check .",
    "lint:fix": "biome lint --write && prettier --write .github/workflows/*.yml .",
    "update": "pu minor && npm i && npm update && (npm audit fix || true) && npm run lint:fix"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@pokujs/monocart": "^1.0.0",
    "@types/node": "^25.5.2",
    "packages-update": "^2.0.0",
    "poku": "^4.2.0",
    "prettier": "^3.8.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "keywords": [
    "toml",
    "parser",
    "config",
    "configuration",
    "node",
    "nodejs",
    "bun",
    "deno",
    "typescript",
    "fast",
    "lightweight"
  ]
}
